[Unit]
Description=AgentWatch web server
After=network-online.target
Wants=network-online.target

[Service]
User=agentwatch
EnvironmentFile=-/etc/agent-watch/rest-api.env
ExecStart=/opt/agent-watch-virtual-environment/bin/uvicorn agent_watch.rest_api.application:application --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always

[Install]
WantedBy=multi-user.target
