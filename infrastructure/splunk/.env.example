# Copy this file to .env and replace the admin password before starting Splunk.
SPLUNK_PASSWORD=replace-with-a-strong-local-password
# Local development token only. Generate a different token for any shared instance.
SPLUNK_HEC_TOKEN=agent-watch-local-hec-token
# Override to pin a particular official Splunk image tag if needed.
SPLUNK_IMAGE=splunk/splunk:10.4
