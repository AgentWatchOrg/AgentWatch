-a always,exit -F arch=b64 -S openat2 -F uid=AGENT_UID -k agent_file
-a always,exit -F arch=b64 -S open,creat -F uid=AGENT_UID -k agent_file
-a always,exit -F arch=b32 -S openat -F uid=AGENT_UID -k agent_file
-a always,exit -F arch=b32 -S openat2 -F uid=AGENT_UID -k agent_file
